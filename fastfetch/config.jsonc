{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 2
        }
    },
    "display": {
        "separator": " ›  "
    },
    "modules": [
	"break",
        {
            "type": "title",
            "key": "USR ",
            "format": "{user-name}",
            "keyColor": "31",  // = color1
        },
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "32",  // = color1
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "PKG ",
            "keyColor": "34",  
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "35", 
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "36", 
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "37", 
        },
        {
            "type": "command",
            "key": "AGE ",
            "keyColor": "38",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
        },
        {
            "type": "colors",
            "key": "CLR ",
            "symbol": "square",
            "keyColor": "31",
        },
        "break",
    ]
}